# Copy to your per-user settings file and fill in. Never commit it.
#   Windows: %APPDATA%/market-research-mcp/.env
#   Other:   ~/.config/market-research-mcp/.env
# Or point MRM_ENV_FILE at another file, or use .env in the working directory (lowest
# priority). Real environment variables win over every file. A .env inside the installed
# plugin folder is never read.
# SEC requires a descriptive User-Agent, for example: Your Name you@example.com
SEC_USER_AGENT=
FRED_API_KEY=
# tiingo (default) or finnhub
PRICE_PROVIDER=tiingo
TIINGO_API_KEY=
FINNHUB_API_KEY=
# Defaults to ~/.market-research/cache.db
CACHE_PATH=
LOG_LEVEL=INFO
# Folder for analyze-ticker briefs: <JOURNAL_DIR>/analyses/. Unset: ./analyses/ under the
# current working directory. The skill reads it via `python -m market_research_mcp.config
# journal-dir`, so it comes from the same sources as the keys.
JOURNAL_DIR=

# Copy to .env and fill in. Never commit .env.
# SEC requires a descriptive User-Agent, for example: Your Name you@example.com
SEC_USER_AGENT=
FRED_API_KEY=
# tiingo (default) or finnhub
PRICE_PROVIDER=tiingo
TIINGO_API_KEY=
FINNHUB_API_KEY=
# Defaults to ~/.market-research/cache.db
CACHE_PATH=
LOG_LEVEL=INFO
# Folder for analyze-ticker briefs (read by the skill, not the server). Briefs go to
# $JOURNAL_DIR/analyses/. Unset: ./analyses/ under the current working directory.
JOURNAL_DIR=
